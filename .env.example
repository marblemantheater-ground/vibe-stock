# 실행 환경: paper(모의투자) | real(실전투자)
KIS_ENV=paper

# ── 모의투자 ──
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT=12345678-01

# ── 실전투자 ──
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT=12345678-01

# (선택) 이미 발급받은 접근토큰. 캐시가 없을 때 시드로 사용되고, 만료 시 자동 재발급됩니다.
KIS_ACCESS_TOKEN=
# (선택) 위 토큰의 만료시각(KST, "YYYY-MM-DD HH:MM:SS"). 비우면 1시간만 신뢰 후 재발급.
KIS_ACCESS_TOKEN_EXPIRES=

# (선택) 튜닝
# KIS_MAX_RPS=            # 미지정 시 실전 15, 모의 2 (초당 요청수)
# KIS_TIMEOUT=10
# KIS_MAX_RETRIES=5
# KIS_TOKEN_REFRESH_MARGIN_SEC=3600
# KIS_REF_SYMBOL=AAPL     # 주문가능금액 조회용 기준 종목
# KIS_REF_EXCHANGE=NASD
# LOG_LEVEL=INFO
